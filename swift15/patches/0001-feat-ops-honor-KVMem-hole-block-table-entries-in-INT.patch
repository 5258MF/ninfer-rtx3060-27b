Subject: [PATCH 01/14] feat(ops): honor KVMem hole block-table entries in
 INT8/RK8V4 small_t, prompt and prompt_fast attention (port of qz 66f63675)

---
 src/core/paged_kv_cache.h                     |  8 +++++
 src/ops/kernel/paged_kv_address.cuh           |  8 +++++
 .../dense/causal_cache/prompt_i8.cuh          | 21 +++++++-----
 .../dense/causal_cache/prompt_i8_fast.cuh     | 18 +++++++----
 .../dense/causal_cache/small_t_i8.cuh         | 32 +++++++++++++------
 5 files changed, 62 insertions(+), 25 deletions(-)

diff --git a/src/core/paged_kv_cache.h b/src/core/paged_kv_cache.h
index 219d5a37..71d3626c 100644
--- a/src/core/paged_kv_cache.h
+++ b/src/core/paged_kv_cache.h
@@ -18,6 +18,14 @@ namespace ninfer {
 
 inline constexpr std::int32_t kPagedKVPageSize = 64;
 
+// A block-table entry equal to kPagedKVPageHole marks the logical page as not materialized in
+// the device pool. Attention consumers treat every key of a hole page as invisible (no score
+// contribution, never dereferenced) instead of decoding it as a physical page ID. Cache-append
+// writers never target a hole page: a growing sequence materializes each page it will write
+// before the launch that writes it, so holes only ever cover historical pages outside the
+// active working-set window.
+inline constexpr std::int32_t kPagedKVPageHole = -1;
+
 /** Non-owning, single-sequence view consumed by growing-cache Ops. */
 struct PagedKVLayerView {
     Tensor k_pages;
diff --git a/src/ops/kernel/paged_kv_address.cuh b/src/ops/kernel/paged_kv_address.cuh
index 8c5c4036..96538dc4 100644
--- a/src/ops/kernel/paged_kv_address.cuh
+++ b/src/ops/kernel/paged_kv_address.cuh
@@ -10,6 +10,14 @@ inline constexpr int kPagedKVPageShift = 6;
 inline constexpr int kPagedKVPageMask  = kPagedKVPageSize - 1;
 
 static_assert(kPagedKVPageSize == (1 << kPagedKVPageShift));
+static_assert(kPagedKVPageSize == 64 && kPagedKVPageHole == -1);
+
+// kPagedKVPageHole semantics (a hole entry marks the logical page as not materialized; keys of
+// that page are invisible to attention and never dereferenced) are defined with the block-table
+// types in core/paged_kv_cache.h; see the constant there.
+__device__ __forceinline__ bool paged_kv_page_is_hole(std::int32_t physical_page) {
+    return physical_page < 0;
+}
 
 struct PagedKVDirectMetadata {
     const std::int32_t* table;

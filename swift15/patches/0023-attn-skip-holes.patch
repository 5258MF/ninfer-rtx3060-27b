From c3329ff036d14a0de85fb21f1769305d8cb9e730 Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Fri, 2 Oct 2026 11:34:18 +0000
Subject: [PATCH] 3060 KVMem: prompt and small-T attention skip hole tiles (no
 load/MMA/mask for pages outside the window)

---
 .../dense/causal_cache/prompt_i8_fast.cuh     | 47 +++++++++++++++----
 .../dense/causal_cache/small_t_i8.cuh         | 43 +++++++++++------
 2 files changed, 66 insertions(+), 24 deletions(-)

diff --git a/src/ops/softmax_attention/dense/causal_cache/prompt_i8_fast.cuh b/src/ops/softmax_attention/dense/causal_cache/prompt_i8_fast.cuh
index 3424d0a2..25955a1e 100644
--- a/src/ops/softmax_attention/dense/causal_cache/prompt_i8_fast.cuh
+++ b/src/ops/softmax_attention/dense/causal_cache/prompt_i8_fast.cuh
@@ -249,11 +249,29 @@ __global__ __launch_bounds__(
     static_assert(KChunks % Threads == 0);
     using KeyChunk = KvPackedKeyChunk<PackedKeys ? Keys : KvKeyCoding::Lloyd4>;
     KeyChunk k_packed[PackedKeys ? KChunksPerThread : 1];
+    // 3060 KVMem: hole tiles (pages outside the device window) are skipped outright instead of
+    // being loaded as zeros, multiplied and masked; a masked tile adds p = 0 with alpha = 1, so
+    // the result is identical. Stages alternate per live tile, not per kb parity.
+    int stage_cur_kb = -1;
+    int stage_cur    = 0;
+    const auto stage_of = [&](int kb) { return kb == stage_cur_kb ? stage_cur : (stage_cur ^ 1); };
+    // Uniform across the CTA (one block table): each warp checks 32 table entries per step.
+    const auto next_live = [&](int k) {
+        while (k < key_blocks) {
+            const int idx = k + lane;
+            const bool live =
+                idx < key_blocks && !paged_kv_page_is_hole(block_table[idx]);
+            const unsigned m = __ballot_sync(FullMask, live);
+            if (m != 0u) { return k + __ffs(static_cast<int>(m)) - 1; }
+            k += 32;
+        }
+        return key_blocks;
+    };
     // Packed keys past the last visible key keep their placeholder's expansion: their scales are
     // zero-filled and their scores masked.
     const auto commit_keys = [&](int kb) {
         if constexpr (PackedKeys) {
-            std::int8_t* k_s = reinterpret_cast<std::int8_t*>(stage_base(kb & 1));
+            std::int8_t* k_s = reinterpret_cast<std::int8_t*>(stage_base(stage_of(kb)));
 #pragma unroll
             for (int i = 0; i < KChunksPerThread; ++i) {
                 const int chunk = tid + i * Threads;
@@ -269,7 +287,7 @@ __global__ __launch_bounds__(
     // packed) and their scales, all contiguous in the cache. Keys past the CTA's last visible key
     // are zero-filled so masked columns stay finite.
     const auto issue_tile = [&](int kb) {
-        unsigned char* base = stage_base(kb & 1);
+        unsigned char* base = stage_base(stage_of(kb));
         std::int8_t* k_s    = reinterpret_cast<std::int8_t*>(base);
         std::int8_t* v_s    = k_s + kCausalPromptI8FastTileBytes;
         __half* ks_s        = reinterpret_cast<__half*>(base + Stage::KScaleOffset);
@@ -390,7 +408,7 @@ __global__ __launch_bounds__(
         tile_live    = false;
         const int k0 = kb * Bc;
         if (!warp_active || k0 > warp_max_qabs) { return; }
-        const unsigned char* base  = stage_base(kb & 1);
+        const unsigned char* base  = stage_base(stage_of(kb));
         const __nv_bfloat16* k_b16 = reinterpret_cast<const __nv_bfloat16*>(base);
         const __half* ks_s = reinterpret_cast<const __half*>(base + Stage::KScaleOffset);
         const __half* vs_s = ks_s + Bc * Groups;
@@ -513,7 +531,7 @@ __global__ __launch_bounds__(
     };
 
     const auto pv_packed = [&](int kb) {
-        const unsigned char* base = stage_base(kb & 1);
+        const unsigned char* base = stage_base(stage_of(kb));
         const std::int8_t* v_s =
             reinterpret_cast<const std::int8_t*>(base) + kCausalPromptI8FastTileBytes;
         const __half* vs_s =
@@ -576,7 +594,7 @@ __global__ __launch_bounds__(
             return;
         }
         const std::int8_t* v_s =
-            reinterpret_cast<const std::int8_t*>(stage_base(kb & 1)) + kCausalPromptI8FastTileBytes;
+            reinterpret_cast<const std::int8_t*>(stage_base(stage_of(kb))) + kCausalPromptI8FastTileBytes;
         const __half* vs_s =
             reinterpret_cast<const __half*>(v_s + kCausalPromptI8FastTileBytes) + Bc * Groups;
         const __half2 mul   = __float2half2_rn(ldexpf(1.0f, -tile_shift));
@@ -659,16 +677,25 @@ __global__ __launch_bounds__(
     };
 
     // Every warp publishes one tile per barrier; the next tile's copy overlaps this tile's math.
-    issue_tile(0);
-    commit_keys(0);
+    int kb = next_live(0);
+    stage_cur_kb = kb;
+    stage_cur    = 0;
+    if (kb < key_blocks) {
+        issue_tile(kb);
+        commit_keys(kb);
+    }
 #pragma unroll 1
-    for (int kb = 0; kb < key_blocks; ++kb) {
+    while (kb < key_blocks) {
+        const int nk = next_live(kb + 1);
         cp_wait<0>();
         __syncthreads();
-        if (kb + 1 < key_blocks) { issue_tile(kb + 1); }
+        if (nk < key_blocks) { issue_tile(nk); }
         qk_softmax(kb);
         pv(kb);
-        if (kb + 1 < key_blocks) { commit_keys(kb + 1); }
+        if (nk < key_blocks) { commit_keys(nk); }
+        kb           = nk;
+        stage_cur_kb = nk;
+        stage_cur ^= 1;
     }
 
     running_l0         = warp_sum<4>(running_l0, FullMask);
diff --git a/src/ops/softmax_attention/dense/causal_cache/small_t_i8.cuh b/src/ops/softmax_attention/dense/causal_cache/small_t_i8.cuh
index da71c030..27fab8c9 100644
--- a/src/ops/softmax_attention/dense/causal_cache/small_t_i8.cuh
+++ b/src/ops/softmax_attention/dense/causal_cache/small_t_i8.cuh
@@ -644,9 +644,26 @@ __launch_bounds__(WarpsPerCta * 32, MinBlocksPerSm) __global__
         ninfer::ops::cp_commit();
     };
 
-    int physical_page = page_at(first_tile);
-    load_k_tile(first_tile, physical_page);
-    issue_kv_tile(first_tile, physical_page);
+    // 3060 KVMem: hole tiles (pages outside the device window) are skipped instead of staged as
+    // zeros and masked; a fully masked tile leaves m, l and acc unchanged, so the result is
+    // identical. Uniform over the CTA (one block table); each warp checks 32 tiles per step.
+    const int tiles_end = first_tile + key_blocks * Bc;
+    const auto next_live_tile = [&](int k) {
+        while (k < tiles_end) {
+            const int kk    = k + lane * Bc;
+            const bool live = kk < tiles_end &&
+                              !paged_kv_page_is_hole(block_table[kk >> kPagedKVPageShift]);
+            const unsigned m = __ballot_sync(FullMask, live);
+            if (m != 0u) { return k + (__ffs(static_cast<int>(m)) - 1) * Bc; }
+            k += 32 * Bc;
+        }
+        return tiles_end;
+    };
+    const int first_live = next_live_tile(first_tile);
+    const int first_load = first_live < tiles_end ? first_live : first_tile;
+    int physical_page = page_at(first_load);
+    load_k_tile(first_load, physical_page);
+    issue_kv_tile(first_load, physical_page);
     if (key_thread) { expand_k_tile(); }
     commit_k_tile();
     ninfer::ops::cp_wait<0>();
@@ -682,17 +699,16 @@ __launch_bounds__(WarpsPerCta * 32, MinBlocksPerSm) __global__
         }
     };
 
-    for (int kb = 0; kb < key_blocks; ++kb) {
-        const int k0        = first_tile + kb * Bc;
+    for (int k0 = first_live; k0 < tiles_end;) {
+        const int nk0       = next_live_tile(k0 + Bc);
         // KVMem hole page: every key of the tile is masked (page-level, uniform over the CTA).
         const bool tile_hole = paged_kv_page_is_hole(page_at(k0));
-        const bool has_next = kb + 1 < key_blocks;
+        const bool has_next = nk0 < tiles_end;
         if constexpr (PackedKeys || EarlyFetch) {
             // Prefetch the next tile now; see load_k_tile and EarlyFetch.
             if (has_next) {
-                const int next_k0 = k0 + Bc;
-                const int next_page =
-                    (next_k0 & kPagedKVPageMask) == 0 ? page_at(next_k0) : physical_page;
+                const int next_k0   = nk0;
+                const int next_page = page_at(next_k0);
                 load_k_tile(next_k0, next_page);
                 fetch_next_tile(next_k0, next_page);
             }
@@ -856,15 +872,13 @@ __launch_bounds__(WarpsPerCta * 32, MinBlocksPerSm) __global__
             }
         } else if constexpr (!SharedDequant) {
             dequant_v(k0, loader_tid, VLoaderThreads);
-            if (kb + 1 < key_blocks) { expand_k_tile(); }
+            if (has_next) { expand_k_tile(); }
         }
         __syncthreads();
 
         if (has_next) {
-            const int next_k0 = k0 + Bc;
-            if ((next_k0 & kPagedKVPageMask) == 0) {
-                physical_page = page_at(next_k0);
-            }
+            const int next_k0 = nk0;
+            physical_page     = page_at(next_k0);
             if constexpr (!EarlyFetch) { issue_kv_tile(next_k0, physical_page); }
         }
 
@@ -927,6 +941,7 @@ __launch_bounds__(WarpsPerCta * 32, MinBlocksPerSm) __global__
             }
         }
         __syncthreads();
+        k0 = nk0;
     }
 
     if constexpr (QkSplit > 1) {
-- 

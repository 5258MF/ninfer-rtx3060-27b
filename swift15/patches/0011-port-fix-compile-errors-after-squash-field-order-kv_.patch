From 6de3953487ee78bf4dc7f93c935e773e2ae5553c Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Thu, 1 Oct 2026 17:11:05 +0000
Subject: [PATCH 11/14] port: fix compile errors after squash (field order,
 kv_pages_for_tokens, replay context carries rope_yarn/fast_prefill)

---
 src/models/qwen3_5/program/planning/request_plan.cpp | 8 ++++++--
 src/models/qwen3_5/program/prefill.cpp               | 8 +++++---
 src/models/qwen3_5/program/transactions/commit.cpp   | 5 +++--
 3 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/src/models/qwen3_5/program/planning/request_plan.cpp b/src/models/qwen3_5/program/planning/request_plan.cpp
index 64397a6f..d35575b5 100644
--- a/src/models/qwen3_5/program/planning/request_plan.cpp
+++ b/src/models/qwen3_5/program/planning/request_plan.cpp
@@ -326,7 +326,7 @@ RequestBasePlan ProgramImpl::plan_request(const PreparedPromptData& prompt,
             kvmem_lane_page_budget(capacity, prefill_chunk, kvmem_window_pages);
         const std::uint32_t backend_budget =
             main_budget + (speculative_backend == SpeculativeBackend::Mtp
-                               ? pages_for_tokens(draft_window - 1U)
+                               ? kv_pages_for_tokens(draft_window - 1U)
                                : 0U);
         main_demand_pages    = std::min(main_demand_pages, main_budget);
         backend_demand_pages = std::min(backend_demand_pages, backend_budget);
@@ -491,12 +491,16 @@ RequestBasePlan ProgramImpl::plan_request(const PreparedPromptData& prompt,
         .physical_peak_additional = root_vector,
         .final_added              = root_vector,
     };
+    const std::uint32_t reserved_context_tokens =
+        base->summary.prompt_tokens + (base->summary.effective_output_tokens == 0
+                                           ? 0U
+                                           : base->summary.effective_output_tokens - 1U);
     if (kvmem_window_pages != 0 && reserved_context_tokens > kvmem_window_pages * 64U) {
         // A single active sparse request can eventually spill every historical page.
         // Make admission reclaim Host cache before it starts, rather than discovering
         // a full Host arena midway through inference. This is preparation headroom,
         // not a fictitious Host allocation in the published owner inventory.
-        const auto pages = static_cast<std::size_t>(pages_for_tokens(reserved_context_tokens)) + 16U;
+        const auto pages = static_cast<std::size_t>(kv_pages_for_tokens(reserved_context_tokens)) + 16U;
         base->root_demand.physical_peak_additional.host.kv_bytes =
             pages * (text_host_kv_page_stride + backend_host_kv_page_stride);
     }
diff --git a/src/models/qwen3_5/program/prefill.cpp b/src/models/qwen3_5/program/prefill.cpp
index 4b9277df..c3094ed6 100644
--- a/src/models/qwen3_5/program/prefill.cpp
+++ b/src/models/qwen3_5/program/prefill.cpp
@@ -1683,13 +1683,15 @@ std::uint32_t ProgramImpl::advance_kvmem_query_replay(SequenceState& sequence,
         execution::PrefillContext replay{
             {device, parameters, work, state_images->linear(),
              replay_records ? &*replay_records : nullptr, io, prefill_hidden, prefill_chunk,
-             proposal_head}, // No Q/K accumulation: the probe owns the retrieval features.
+             proposal_head, stage_runtime.get(), rope_yarn, fast_prefill_kernel,
+             mtp_attention_window}, // No Q/K accumulation: the probe owns the retrieval features.
             text_kv_view(sequence), mtp_kv_view(sequence), decoder->text_kv, decoder->mtp_cache(),
             dflash ? &*dflash : nullptr, cursor,
             static_cast<const ops::SamplingConfig*>(
                 sampling_config.slice(1, static_cast<std::int32_t>(sequence.lane), 1).data),
-            nullptr, slots.source, slots.destination, staged.initial_mtp_extent, dflash_host_ingress,
-            sequence.kv->backend ? backend_kv_addresses->bound_row(*sequence.kv->backend) : 0};
+            nullptr, slots.source, slots.destination, staged.initial_mtp_extent, dflash_host_ingress};
+        replay.dflash_kv_table_row =
+            sequence.kv->backend ? backend_kv_addresses->bound_row(*sequence.kv->backend) : 0;
         if (dflash) { mark_workspace_usage(workspace_plan.dflash_context); }
         const auto count = std::min(prefill_chunk, staged.prompt_tokens - cursor);
         const auto split = std::upper_bound(staged.prompt.identity.rewrite_execution_frontiers.begin(),
diff --git a/src/models/qwen3_5/program/transactions/commit.cpp b/src/models/qwen3_5/program/transactions/commit.cpp
index 0ff06d82..5fe712b0 100644
--- a/src/models/qwen3_5/program/transactions/commit.cpp
+++ b/src/models/qwen3_5/program/transactions/commit.cpp
@@ -380,8 +380,9 @@ runtime::ExecutionTiming ProgramImpl::append_forced_tokens(
                     selectors.source,
                     selectors.destination,
                     0,
-                    dflash_host_ingress,
-                    sequence.kv->backend ? backend_kv_addresses->bound_row(*sequence.kv->backend) : 0};
+                    dflash_host_ingress};
+                schedule_state.dflash_kv_table_row =
+                    sequence.kv->backend ? backend_kv_addresses->bound_row(*sequence.kv->backend) : 0;
                 mark_workspace_usage(speculative_backend == SpeculativeBackend::Mtp
                                          ? workspace_plan.mtp_prefill
                                          : workspace_plan.text_prefill);
-- 

From 2eee5583a53f877c5a9932f94cc9124a628694bc Mon Sep 17 00:00:00 2001
From: p <p@l>
Date: Fri, 2 Oct 2026 15:23:47 +0000
Subject: [PATCH] 3060: target 28 SMs (GDN gating route table, rope wave
 capacity, rmsnorm fallback)

---
 .../bf16/bf16_gdn_gating_proj_plan.cpp        | 25 ++++++++++++-------
 src/ops/launcher/rmsnorm.cu                   |  2 +-
 src/ops/launcher/rope.cu                      |  8 ++++--
 3 files changed, 23 insertions(+), 12 deletions(-)

diff --git a/src/ops/gdn_gating_proj/bf16/bf16_gdn_gating_proj_plan.cpp b/src/ops/gdn_gating_proj/bf16/bf16_gdn_gating_proj_plan.cpp
index 5bf79992..c008b579 100644
--- a/src/ops/gdn_gating_proj/bf16/bf16_gdn_gating_proj_plan.cpp
+++ b/src/ops/gdn_gating_proj/bf16/bf16_gdn_gating_proj_plan.cpp
@@ -38,21 +38,24 @@ constexpr std::array<RouteSpec, 6> k27Routes{{
     // 8 warps at 65 registers, so 8*32*72 = 18,432 registers admits three CTAs/SM while the 40 KiB
     // of dynamic shared memory admits two. Shared memory binds: 2 CTAs/SM -> 164 device-wide.
     // Grid is ceil(T/128)*3*SplitK, so the legal ends are 768 / 1664 / 3456.
-    {{9, 768}, Bf16GdnGatingScheduleId::MmaCooperativeSplit8},
-    {{769, 1664}, Bf16GdnGatingScheduleId::MmaCooperativeSplit4},
-    {{1665, 3456}, Bf16GdnGatingScheduleId::MmaCooperativeSplit2},
-    {{3457, kAnyCols}, Bf16GdnGatingScheduleId::MmaUnsplit},
+    // 3060 (28 SMs): 2 CTAs/SM -> 56 device-wide, so the legal ends are 256 / 512 / 1152 (the
+    // 82-SM table above ended at 768 / 1664 / 3456; the runtime already fell through to these).
+    {{9, 256}, Bf16GdnGatingScheduleId::MmaCooperativeSplit8},
+    {{257, 512}, Bf16GdnGatingScheduleId::MmaCooperativeSplit4},
+    {{513, 1152}, Bf16GdnGatingScheduleId::MmaCooperativeSplit2},
+    {{1153, kAnyCols}, Bf16GdnGatingScheduleId::MmaUnsplit},
 }};
 
 constexpr std::array<RouteSpec, 5> k35Routes{{
     // Same progression, clamped to the sm_86 residency ceilings. Grid is ceil(T/64)*2*SplitK, so
     // with 328 CTAs for split16 and 246 for split8/4/2 the legal ends are 640 / 960 / 1920 / 3904.
     // The upstream bounds (1024 / 2048 / 4096) each land on 256 CTAs and exceed the 246 limit.
+    // 3060 (28 SMs): 112 CTAs for split16, 84 for split8/4/2 -> legal ends 192 / 320 / 640 / 1344.
     {{1, 127}, Bf16GdnGatingScheduleId::MmaCooperativeSplit16},
-    {{128, 960}, Bf16GdnGatingScheduleId::MmaCooperativeSplit8},
-    {{961, 1920}, Bf16GdnGatingScheduleId::MmaCooperativeSplit4},
-    {{1921, 3904}, Bf16GdnGatingScheduleId::MmaCooperativeSplit2},
-    {{3905, kAnyCols}, Bf16GdnGatingScheduleId::MmaUnsplit},
+    {{128, 320}, Bf16GdnGatingScheduleId::MmaCooperativeSplit8},
+    {{321, 640}, Bf16GdnGatingScheduleId::MmaCooperativeSplit4},
+    {{641, 1344}, Bf16GdnGatingScheduleId::MmaCooperativeSplit2},
+    {{1345, kAnyCols}, Bf16GdnGatingScheduleId::MmaUnsplit},
 }};
 
 template <std::size_t N>
@@ -95,7 +98,11 @@ constexpr std::int32_t ctas_per_sm_35(Bf16GdnGatingScheduleId schedule) noexcept
 // targets, so the compile-time catalog guard is checked against it: a route that fits on 82 SMs
 // fits on every supported device. Overshooting the real budget is not merely slow -- the driver
 // rejects the launch with cudaErrorCooperativeLaunchTooLarge -- so this must stay a lower bound.
-inline constexpr std::int32_t kMinSupportedSmCount = 82;
+// 3060 port: the build targets the RTX 3060 (28 SMs, same as the old engine's kTargetSmCount).
+#ifndef NINFER_TARGET_SM_COUNT
+#define NINFER_TARGET_SM_COUNT 28
+#endif
+inline constexpr std::int32_t kMinSupportedSmCount = NINFER_TARGET_SM_COUNT;
 
 // SM count of the active device, cached per device index. cudaDeviceGetAttribute is cheap but this
 // sits on the per-request planning path. Per device rather than once per process, because a model
diff --git a/src/ops/launcher/rmsnorm.cu b/src/ops/launcher/rmsnorm.cu
index 3598575a..ad8f5c06 100644
--- a/src/ops/launcher/rmsnorm.cu
+++ b/src/ops/launcher/rmsnorm.cu
@@ -23,7 +23,7 @@ namespace {
 // the SM count of the current device, cached per device index because a model split over several
 // GPUs launches each stage on its own device. A failed query keeps the swept part's 170.
 std::int64_t rms_prefetch_blocks() noexcept {
-    constexpr std::int64_t kSweptPartSms = 170;
+    constexpr std::int64_t kSweptPartSms = 28;  // 3060 port: fallback when the SM query fails
     constexpr int kCachedDevices         = 64;
     static std::array<std::atomic<std::int32_t>, kCachedDevices> cache{};
     int device = 0;
diff --git a/src/ops/launcher/rope.cu b/src/ops/launcher/rope.cu
index fbff52e1..46e1ec2b 100644
--- a/src/ops/launcher/rope.cu
+++ b/src/ops/launcher/rope.cu
@@ -17,8 +17,12 @@ constexpr int kLargeBlock               = 256;
 constexpr int kFullChunkBlock           = 192;
 constexpr int kSmallBlock               = 128;
 constexpr int kDefaultChunkTargetTokens = 1024;
-// RTX 5090 has 170 SMs and admits six of these 256-thread CTAs per SM.
-constexpr int kLargeBlockWaveCapacity = 1020;
+// One full wave of 256-thread CTAs: six per SM. Upstream swept it on an RTX 5090 (170 SMs -> 1020);
+// the 3060 port targets 28 SMs (old engine kTargetSmCount) -> 168.
+#ifndef NINFER_TARGET_SM_COUNT
+#define NINFER_TARGET_SM_COUNT 28
+#endif
+constexpr int kLargeBlockWaveCapacity = 6 * NINFER_TARGET_SM_COUNT;
 
 template <RopeKernelMode Mode>
 inline constexpr bool kTextMode =
-- 
2.47.3


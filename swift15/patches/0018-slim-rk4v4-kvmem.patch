From cdbe469e65b1ea5f2f53a26487b00966c4a7d04c Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Fri, 2 Oct 2026 03:00:25 +0000
Subject: [PATCH] NINFER_SLIM_3060: keep rk4v4 (Lloyd4 keys) kernels; allow
 KVMem with rk4v4

---
 .../softmax_attention/dense/causal_cache/prompt.cu  | 13 +++++++++----
 .../dense/causal_cache/small_t_i8_launch.cuh        | 10 ++++++----
 src/runtime/engine/model_instance.cpp               |  6 ++++--
 src/serve/serve_options.cpp                         |  7 ++++---
 4 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/src/ops/softmax_attention/dense/causal_cache/prompt.cu b/src/ops/softmax_attention/dense/causal_cache/prompt.cu
index af44b219..e2a6a25a 100644
--- a/src/ops/softmax_attention/dense/causal_cache/prompt.cu
+++ b/src/ops/softmax_attention/dense/causal_cache/prompt.cu
@@ -125,12 +125,12 @@ void causal_attention_prompt_attention_launch_for(const Tensor& q, const Tensor&
                                                                    metadata, out, stream);
         return;
     }
-#if !defined(NINFER_SLIM_3060)
     if (fast && cache.storage == KvCacheStorage::RotatedLloyd4KeyInt4Value) {
         causal_attention_prompt_i8_fast_launch_for<Geometry, true, KvKeyCoding::Lloyd4>(
             q, positions, scale, cache, metadata, out, stream);
         return;
     }
+#if !defined(NINFER_SLIM_3060)
     if (fast && cache.storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8) {
         causal_attention_prompt_i8_fast_launch_for<Geometry, true, KvKeyCoding::Int4E8>(
             q, positions, scale, cache, metadata, out, stream);
@@ -190,11 +190,16 @@ void causal_attention_prompt_attention_launch_for(const Tensor& q, const Tensor&
         const bool pv_f16 = prompt_pv_f16();
 #if defined(NINFER_SLIM_3060)
         if (cache.storage != KvCacheStorage::Int8Group64 &&
-            cache.storage != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64) {
+            cache.storage != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64 &&
+            cache.storage != KvCacheStorage::RotatedLloyd4KeyInt4Value) {
             throw std::runtime_error(
-                "prompt attention: this NINFER_SLIM_3060 build supports only int8 / rk8v4 KV caches");
+                "prompt attention: this NINFER_SLIM_3060 build supports only int8 / rk8v4 / rk4v4 KV caches");
         }
-        if (cache_v.dtype == DType::U8 && pv_f16) {
+        if (cache.storage == KvCacheStorage::RotatedLloyd4KeyInt4Value && pv_f16) {
+            launch_i8.template operator()<true, KvKeyCoding::Lloyd4, true>();
+        } else if (cache.storage == KvCacheStorage::RotatedLloyd4KeyInt4Value) {
+            launch_i8.template operator()<true, KvKeyCoding::Lloyd4, false>();
+        } else if (cache_v.dtype == DType::U8 && pv_f16) {
             launch_i8.template operator()<true, KvKeyCoding::Int8, true>();
         } else if (cache_v.dtype == DType::U8) {
             launch_i8.template operator()<true, KvKeyCoding::Int8, false>();
diff --git a/src/ops/softmax_attention/dense/causal_cache/small_t_i8_launch.cuh b/src/ops/softmax_attention/dense/causal_cache/small_t_i8_launch.cuh
index 6fa5cfd5..3714bcb3 100644
--- a/src/ops/softmax_attention/dense/causal_cache/small_t_i8_launch.cuh
+++ b/src/ops/softmax_attention/dense/causal_cache/small_t_i8_launch.cuh
@@ -87,11 +87,13 @@ void launch_tc_partial_i8(const Tensor& q, CacheInput input, const Tensor& pos,
             }
         };
 #if defined(NINFER_SLIM_3060)
-        if (cache.storage == KvCacheStorage::RotatedLloyd4KeyInt4Value ||
-            cache.storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8 ||
-            cache.storage == KvCacheStorage::RotatedE8RootKeyInt4Value) {
+        // Slim build: int8, rk8v4 and rk4v4 (Lloyd4 keys); the E8 codings are left out.
+        if (cache.storage == KvCacheStorage::RotatedLloyd4KeyInt4Value) {
+            issue.template operator()<true, KvKeyCoding::Lloyd4>();
+        } else if (cache.storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8 ||
+                   cache.storage == KvCacheStorage::RotatedE8RootKeyInt4Value) {
             throw std::runtime_error(
-                "small_t_i8: this NINFER_SLIM_3060 build supports only int8 / rk8v4 KV caches");
+                "small_t_i8: this NINFER_SLIM_3060 build supports only int8 / rk8v4 / rk4v4 KV caches");
         } else if (packed_values) {
             issue.template operator()<true, KvKeyCoding::Int8>();
         } else {
diff --git a/src/runtime/engine/model_instance.cpp b/src/runtime/engine/model_instance.cpp
index 0a5bc570..6059e0f2 100644
--- a/src/runtime/engine/model_instance.cpp
+++ b/src/runtime/engine/model_instance.cpp
@@ -259,9 +259,11 @@ EngineOptions normalize_engine_options(EngineOptions options) {
         // Port limits (ninfer-all base): hole pages are honored only by the INT8-family attention
         // kernels (int8 / rk8v4), the sparse working set is single-device, and the hybrid prefix
         // cache snapshots device-only state. KV lease growth is subsumed by the window.
+        // rk4v4 shares the same INT8-family kernels (Lloyd4 keys), which honor holes too.
         if (options.kv_cache != KvCacheStorage::Int8Group64 &&
-            options.kv_cache != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64) {
-            throw std::invalid_argument("KVMem requires --kv-dtype int8 or rk8v4");
+            options.kv_cache != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64 &&
+            options.kv_cache != KvCacheStorage::RotatedLloyd4KeyInt4Value) {
+            throw std::invalid_argument("KVMem requires --kv-dtype int8, rk8v4 or rk4v4");
         }
         if (options.devices.size() > 1) {
             throw std::invalid_argument("KVMem supports a single device only");
diff --git a/src/serve/serve_options.cpp b/src/serve/serve_options.cpp
index f87acd56..55c7b545 100644
--- a/src/serve/serve_options.cpp
+++ b/src/serve/serve_options.cpp
@@ -68,15 +68,16 @@ KvCacheStorage parse_kv_dtype_any(const char* text) {
     throw std::invalid_argument("invalid kv-dtype: " + value);
 }
 
-// NINFER_SLIM_3060 builds only the bf16, int8 and rk8v4 decode-attention kernels.
+// NINFER_SLIM_3060 builds only the bf16, int8, rk8v4 and rk4v4 decode-attention kernels.
 KvCacheStorage parse_kv_dtype(const char* text) {
     const KvCacheStorage storage = parse_kv_dtype_any(text);
 #if defined(NINFER_SLIM_3060)
     if (storage != KvCacheStorage::BFloat16 && storage != KvCacheStorage::Int8Group64 &&
-        storage != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64) {
+        storage != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64 &&
+        storage != KvCacheStorage::RotatedLloyd4KeyInt4Value) {
         throw std::invalid_argument(std::string("kv-dtype ") + text +
                                     " is not built into this NINFER_SLIM_3060 engine "
-                                    "(use int8 or rk8v4)");
+                                    "(use int8, rk8v4 or rk4v4)");
     }
 #endif
     return storage;
-- 
2.47.3


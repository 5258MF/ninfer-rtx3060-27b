     bool gdn_state_fp16 = false;
     bool rope_yarn      = false;
diff --git a/include/ninfer/types.h b/include/ninfer/types.h
index 4057b150..f9646e10 100644
--- a/include/ninfer/types.h
+++ b/include/ninfer/types.h
@@ -446,6 +446,9 @@ struct EngineOptions {
     // Q6G64 token embedding: the narrower-model option where Q4 costs measurable perplexity
     // (the 35B-A3B's 2048-wide table). Mutually exclusive with embedding_q4.
     bool embedding_q6                      = false;
+    // 3060 local patch: keep the token embedding in pinned, device-mapped host memory (zero-copy
+    // row gather over PCIe) instead of the device weight arena. Saves its full size in VRAM.
+    bool embedding_host                    = false;
     // Qwen3.6-35B-A3B only: the MTP draft layer's routed experts are stored W8 in the artifact;
     // transcode them to the text layers' formats (Q4 gate_up, Q6 down) at load. Drafts are
     // verified exactly, so this can change acceptance but never the output distribution.
diff --git a/src/models/load_options.h b/src/models/load_options.h
index e7806311..c6344e77 100644
--- a/src/models/load_options.h
+++ b/src/models/load_options.h
@@ -20,6 +20,7 @@ struct LoadOptions {
     bool lm_head_q6     = false;
     bool embedding_q4   = false;
     bool embedding_q6   = false;
+    bool embedding_host = false; // 3060: token embedding in pinned host memory
     bool mtp_experts_q4 = false;
     // Execution selection carried with the instance: admit the integer small-T gate_up route at
     // verify widths (see execution::DenseParameters::verify_gate_up_policy).
@@ -111,6 +112,7 @@ struct LoadOptions {
             .lm_head_q6     = options.lm_head_q6,
             .embedding_q4   = options.embedding_q4,
             .embedding_q6   = options.embedding_q6,
+            .embedding_host = options.embedding_host,
             .mtp_experts_q4 = options.mtp_experts_q4,
             .mlp_a8_decode  = options.mlp_a8_decode,
             .prefill_a8     = options.prefill_a8,
diff --git a/src/models/qwen3_5/execution/parameters.cpp b/src/models/qwen3_5/execution/parameters.cpp
index d498b5ce..027f2973 100644
--- a/src/models/qwen3_5/execution/parameters.cpp
+++ b/src/models/qwen3_5/execution/parameters.cpp
@@ -3,6 +3,9 @@
 
 #include "core/weight_view.h"
 
+#include <cuda_runtime.h>
+#include <cstdio>
+
 #include <array>
 #include <limits>
 #include <type_traits>
@@ -406,6 +409,24 @@ Parameters::Parameters(const Model& source) : model(source) {
     const Prepare prepare(model);
     const auto& w        = model.weights();
     text.token_embedding = native_weight(model.weight(w.text.token_embedding).view);
+    {
+        // 3060: --embedding-host leaves the table in pinned host memory. Kernels dereference it
+        // directly, which needs the host pointer to be the device pointer (unified addressing).
+        cudaPointerAttributes attributes{};
+        const void* const table = text.token_embedding.payload;
+        if (cudaPointerGetAttributes(&attributes, table) != cudaSuccess) {
+            (void)cudaGetLastError();
+        } else if (attributes.type == cudaMemoryTypeHost) {
+            if (attributes.devicePointer != table) {
+                throw std::runtime_error(
+                    "--embedding-host needs unified addressing (host pointer != device pointer)");
+            }
+            std::fprintf(stderr,
+                         "[embed-host] token embedding in pinned host RAM: %.1f MiB (zero-copy)\n",
+                         static_cast<double>(text.token_embedding.payload_bytes) /
+                             (1024.0 * 1024.0));
+        }
+    }
     text.output_head     = prepare.head(w.text.output_head_use);
     if (text.token_embedding.qtype == QType::T2_G128_FP16) {
         // A ternary checkpoint stores its token table rotated by the same hidden-width signs as
diff --git a/src/models/qwen3_5/load/storage_trades.cpp b/src/models/qwen3_5/load/storage_trades.cpp
index 04d9f43e..713551d8 100644
--- a/src/models/qwen3_5/load/storage_trades.cpp
+++ b/src/models/qwen3_5/load/storage_trades.cpp
@@ -13,6 +13,9 @@ void apply_storage_trades(Bindings& bindings, const Config& config, const ModelW
     if (options.lm_head_q4 && options.lm_head_q6) {
         throw std::invalid_argument("--lm-head-q4 and --lm-head-q6 are mutually exclusive");
     }
+    if (options.embedding_host && (options.embedding_q4 || options.embedding_q6)) {
+        throw std::invalid_argument("--embedding-host cannot be combined with --embedding-q4/q6");
+    }
     if (options.embedding_q4 && options.embedding_q6) {
         throw std::invalid_argument("--embedding-q4 and --embedding-q6 are mutually exclusive");
     }
diff --git a/src/models/qwen3_5/load/text.cpp b/src/models/qwen3_5/load/text.cpp
index fd7e1be2..38ee46f8 100644
--- a/src/models/qwen3_5/load/text.cpp
+++ b/src/models/qwen3_5/load/text.cpp
@@ -162,7 +162,9 @@ TextWeights bind_text(Bindings& b, const TextConfig& config, const LoadOptions&
     TextWeights out;
     out.stages = std::move(stages);
     out.token_embedding =
-        b.parameter("text/token_embedding", {config.vocab_size, config.hidden_size});
+        b.parameter("text/token_embedding", {config.vocab_size, config.hidden_size}, {}, {},
+                    options.embedding_host ? artifact::Residency::Pinned
+                                           : artifact::Residency::Device);
     std::vector<std::string> head_inputs{"text/final_hidden"};
     if (options.speculative != SpeculativeBackend::None && !options.proposal_enabled()) {
         head_inputs.push_back(std::string(options.speculative_component()) + "/final_hidden");
diff --git a/src/models/qwen3_5/load/vision_overlay.cpp b/src/models/qwen3_5/load/vision_overlay.cpp
index b92abafb..4cabbaa9 100644
--- a/src/models/qwen3_5/load/vision_overlay.cpp
+++ b/src/models/qwen3_5/load/vision_overlay.cpp
@@ -77,7 +77,11 @@ void apply_vision_overlay_placement(Bindings& bindings, const ModelWeights& weig
         bindings.evict(WeightId{index}, kEvictRankMtp);
     }
     if (weights.proposal) { bindings.evict(weights.proposal->head, kEvictRankProposalHead); }
-    bindings.evict(weights.text.token_embedding, kEvictRankEmbedding);
+    // 3060: a host-resident (--embedding-host) table is not in the device arena at all.
+    if (bindings.at(weights.text.token_embedding).reference.residency ==
+        artifact::Residency::Device) {
+        bindings.evict(weights.text.token_embedding, kEvictRankEmbedding);
+    }
     bindings.evict(weights.text.output_head, kEvictRankOutputHead);
 }
 

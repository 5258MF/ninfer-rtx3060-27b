index a46f007c..53f2e2d1 100644
--- a/apps/cli/options.cpp
+++ b/apps/cli/options.cpp
@@ -208,6 +208,8 @@ std::string usage_text(const char* argv0) {
            "  --embedding-q4 | --embedding-q6\n"
            "                                store the token embedding as Q4 or Q6 while\n"
            "                                loading\n"
+           "  --embedding-host              keep the token embedding in pinned host memory\n"

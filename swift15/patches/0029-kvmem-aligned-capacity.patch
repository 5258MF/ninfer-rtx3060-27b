From ca62eacafe273434a9af6df568a20417acf18ae9 Mon Sep 17 00:00:00 2001
From: 5258MF <5258MF@users.noreply.github.com>
Date: Sat, 3 Oct 2026 13:56:24 +0800
Subject: [PATCH] fix(runtime): use planned KVMem capacity after prefill
 alignment

---
 src/runtime/engine/model_instance.cpp | 11 ++++-------
 1 file changed, 4 insertions(+), 7 deletions(-)

diff --git a/src/runtime/engine/model_instance.cpp b/src/runtime/engine/model_instance.cpp
index 6059e0f..cef448c 100644
--- a/src/runtime/engine/model_instance.cpp
+++ b/src/runtime/engine/model_instance.cpp
@@ -11,7 +11,6 @@
 #include "core/startup.h"
 #include "models/qwen3_5/load.h"
 #include "models/qwen3_5/measurement.h"
-#include "models/qwen3_5/program/retrieval/window_capacity.h"
 
 #include <algorithm>
 #include <cmath>
@@ -622,14 +621,12 @@ ConstructedModel construct_model(const EngineOptions& requested, DeviceContext&
                            instance->model->storage_stats().device_capacity_bytes);
     KvCapacityPolicy capacity_policy = options.kv_capacity;
     // KVMem: a sparse working set sizes the Main pool by its window; automatic free-memory sizing
-    // would otherwise grow the pool toward the logical ceiling and defeat the window. Each lane
-    // also covers one prefill chunk of growth past its window plus the sink/slack margins.
+    // would otherwise grow the pool toward the logical ceiling and defeat the window. The planner
+    // includes the device-aligned prefill chunk and sink/slack margins. Recomputing
+    // this floor from options.prefill_chunk can under-allocate when SM alignment grows the chunk.
     if (options.kvmem_window_pages != 0 && capacity_policy.mode == KvCapacityMode::Automatic) {
         capacity_policy = KvCapacityPolicy::explicit_capacity(
-            models::qwen3_5::detail::kvmem_pool_page_budget(
-                options.max_context, options.prefill_chunk, options.kvmem_window_pages,
-                options.max_concurrency) *
-            static_cast<std::uint32_t>(kPagedKVPageSize));
+            curve.resolved_tokens(curve.minimum_main_page_groups));
     }
     if (residency) {
         const auto memory = residency->stats();
-- 

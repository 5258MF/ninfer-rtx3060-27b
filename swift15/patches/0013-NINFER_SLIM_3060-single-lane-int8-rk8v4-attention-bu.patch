diff --git a/CMakeLists.txt b/CMakeLists.txt
index b069b95b..921dd578 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -63,6 +63,15 @@ if(CMAKE_CUDA_ARCHITECTURES STREQUAL "120a")
   add_compile_definitions(NINFER_SM120_NVFP4=1 NINFER_SM120_FP8=1)
 endif()
 
+# NINFER_SLIM_3060: a single-lane RTX 3060 build. The decode attention keeps only the 24-head
+# geometry, single-batch launches and the int8 / rk8v4 KV codings; the FP8, NVFP4 and K8V4 KV
+# attention units are left out (their entry points throw). Other KV dtypes and
+# --max-concurrency > 1 are refused at startup.
+option(NINFER_SLIM_3060 "Single-lane int8/rk8v4 build for the RTX 3060 deployment" OFF)
+if(NINFER_SLIM_3060)
+  add_compile_definitions(NINFER_SLIM_3060=1)
+endif()
+
 # --- Global settings ---------------------------------------------------------
 option(NINFER_BUILD_APPS "Build the NInfer CLI, server and perplexity evaluator" ON)
 option(BUILD_TESTING "Build NInfer tests" OFF)

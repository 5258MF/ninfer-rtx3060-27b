index 1da0de9c..f87acd56 100644
--- a/src/serve/serve_options.cpp
+++ b/src/serve/serve_options.cpp
@@ -50,7 +50,7 @@ std::uint64_t parse_u64(const char* text, const char* label) {
     return static_cast<std::uint64_t>(value);
 }
 
-KvCacheStorage parse_kv_dtype(const char* text) {
+KvCacheStorage parse_kv_dtype_any(const char* text) {
     const std::string value(text);
     if (value == "bf16") { return KvCacheStorage::BFloat16; }
     if (value == "int8") { return KvCacheStorage::Int8Group64; }
@@ -68,6 +68,20 @@ KvCacheStorage parse_kv_dtype(const char* text) {
     throw std::invalid_argument("invalid kv-dtype: " + value);
 }
 
+// NINFER_SLIM_3060 builds only the bf16, int8 and rk8v4 decode-attention kernels.
+KvCacheStorage parse_kv_dtype(const char* text) {
+    const KvCacheStorage storage = parse_kv_dtype_any(text);
+#if defined(NINFER_SLIM_3060)
+    if (storage != KvCacheStorage::BFloat16 && storage != KvCacheStorage::Int8Group64 &&
+        storage != KvCacheStorage::RotatedInt8KeyInt4ValueGroup64) {
+        throw std::invalid_argument(std::string("kv-dtype ") + text +
+                                    " is not built into this NINFER_SLIM_3060 engine "
+                                    "(use int8 or rk8v4)");
+    }
+#endif
+    return storage;
+}
+
 KvCapacityPolicy parse_kv_capacity(const char* text) {
     if (std::string_view(text) == "auto") { return KvCapacityPolicy::automatic(); }
     const int value = parse_nonnegative_int(text, "kv-capacity");
@@ -1160,6 +1174,12 @@ ServeOptions parse_serve_options(int argc, char** argv) {
     if (options.max_concurrency == 0 || options.max_concurrency > kMaximumConcurrency) {
         throw std::invalid_argument("--max-concurrency must be in [1,8]");
     }
+#if defined(NINFER_SLIM_3060)
+    if (options.max_concurrency != 1) {
+        throw std::invalid_argument("this NINFER_SLIM_3060 build serves one lane: "
+                                    "--max-concurrency must be 1");
+    }
+#endif
     if (options.max_pending_requests == 0) {
         throw std::invalid_argument("--max-pending-requests must be positive");
     }
